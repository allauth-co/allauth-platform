# Copy into .env.local for Node development. Keep real values out of Git.
# Existing deployments can keep BETTER_AUTH_URL and BETTER_AUTH_SECRET.
# If setting both names during a migration, use exactly the same values.
ALLAUTH_AUTH_URL=http://localhost:3002
AUTH_RUNTIME=node
ALLAUTH_AUTH_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://allauth:password@localhost:55445/allauth
DATABASE_POOL_MAX=5
TRUSTED_ORIGINS=http://localhost:3002
AUTH_APP_NAME=AllAuth
RP_ID=localhost
RP_NAME=AllAuth
EMAIL_FROM=security@example.com
ADMIN_EMAIL=admin@example.com

# Explicit self-hosted mode enables all features without billing credentials.
# Managed AllAuth deployments must use hosted, even while checkout is disabled.
ALLAUTH_DEPLOYMENT_MODE=self-hosted
ALLAUTH_BILLING_CHECKOUT_ENABLED=false
ALLAUTH_BILLING_ENFORCEMENT_ENABLED=false

# Hosted billing only. Never use NEXT_PUBLIC_ names for keys.
# After changing enforcement or deployment mode, run db:migrate to synchronise
# database guards before starting the service. Keep sandbox and live separate.
ALLAUTH_STRIPE_ACCOUNT_ID=
ALLAUTH_STRIPE_LIVEMODE=false
ALLAUTH_STRIPE_PRO_PRICE_ID=
ALLAUTH_STRIPE_SECRET_KEY=
ALLAUTH_STRIPE_WEBHOOK_SECRET=
ALLAUTH_STRIPE_PORTAL_CONFIGURATION_ID=
ALLAUTH_STRIPE_AUTOMATIC_TAX_ENABLED=false

# Optional self-hosted platform email. Leave both blank to keep delivery disabled.
EMAIL_PROVIDER=
RESEND_API_KEY=

# Production Google Web OAuth callback:
# https://auth.example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional social providers. Their controls appear only when both keys exist.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Email Sending REST API works from Railway and local Node.
# Use an account-scoped Email Sending: Edit token; keep real values private.
# Leaving these empty disables live email. Test fixtures use an in-memory outbox.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# Optional project-only Resend transport. Replace hyphens in the exact project
# slug with underscores and uppercase it. These never change other app senders.
# Keep keys server-side; use a sending-only key restricted to the verified domain.
# ALLAUTH_PROJECT_EXAMPLE_PRODUCTION_EMAIL_PROVIDER=resend
# ALLAUTH_PROJECT_EXAMPLE_PRODUCTION_EMAIL_FROM=security@example.com
# ALLAUTH_PROJECT_EXAMPLE_PRODUCTION_EMAIL_FROM_NAME=Example
# ALLAUTH_PROJECT_EXAMPLE_PRODUCTION_RESEND_API_KEY=
# ALLAUTH_PROJECT_EXAMPLE_DEVELOPMENT_EMAIL_PROVIDER=resend
# ALLAUTH_PROJECT_EXAMPLE_DEVELOPMENT_EMAIL_FROM=security@example.com
# ALLAUTH_PROJECT_EXAMPLE_DEVELOPMENT_EMAIL_FROM_NAME=Example
# ALLAUTH_PROJECT_EXAMPLE_DEVELOPMENT_RESEND_API_KEY=

# Independent random key for hashing managed SCIM connection credentials.
SCIM_CREDENTIAL_HASH_SECRET=replace-with-another-independent-random-secret

# Verified-account workspace provisioning limits (platform administrators are exempt).
WORKSPACE_MAX_OWNED=3
WORKSPACE_MAX_APPLICATIONS=5
WORKSPACE_MAX_MEMBERS=50
WORKSPACE_MAX_INVITATIONS=20
# Hosted application domains. Create the shared secret privately, store it in
# Railway and the domain gateway Worker, and set READY only after DNS/routes work.
ALLAUTH_HOSTING_BASE_DOMAIN=
ALLAUTH_ORIGIN_HOSTNAME=
ALLAUTH_EDGE_SECRET=
CLOUDFLARE_SAAS_ZONE_ID=
CLOUDFLARE_SAAS_API_TOKEN=
CLOUDFLARE_SAAS_CNAME_TARGET=
CLOUDFLARE_SAAS_READY=false

# Application branding assets: signed uploads to the Cloudflare R2 asset Worker.
ALLAUTH_ASSET_ORIGIN=
ALLAUTH_ASSET_SECRET=

# Server-only JSON map keyed by exact environment slug; never use a NEXT_PUBLIC_ variable.
# See docs/content/docs/integrations/allauth-tenant-apple.mdx for the schema and HTTPS callbacks.
ALLAUTH_PROJECT_APPLE_PROVIDERS=

# Server-only Microsoft map keyed by exact environment slug. Entries contain
# clientId (Entra application GUID), clientSecret and optional tenantId (common,
# organizations, consumers or tenant GUID). No fallback to platform credentials.
# See docs/content/docs/integrations/allauth-tenant-microsoft.mdx.
ALLAUTH_PROJECT_MICROSOFT_PROVIDERS=
