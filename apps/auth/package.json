{
  "name": "@allauth/auth-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "next dev",
    "dev:secure": "next dev --experimental-https",
    "typecheck": "node scripts/verify-native-links.mjs && next typegen && tsc --noEmit --incremental false",
    "build": "pnpm run check:sdk && pnpm run verify:sdk-artifact --served && node scripts/verify-native-links.mjs && next build --webpack",
    "start": "next start",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false cloudflare-env.d.ts",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:generate": "node scripts/generate-schema.mjs",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "db:initialize-self-host": "tsx scripts/self-host-bootstrap.ts",
    "billing:setup": "tsx scripts/billing-setup.ts",
    "billing:reconcile": "tsx scripts/billing-reconcile.ts",
    "billing:sandbox-check": "tsx scripts/billing-sandbox-check.ts",
    "check:auth": "tsx scripts/auth-check.ts",
    "build:docker": "docker build -f Dockerfile -t allauth-auth:railway ../..",
    "check:container": "node scripts/container-check.mjs",
    "verify:auth-source": "node scripts/verify-native-links.mjs",
    "check:sdk": "pnpm run check:sdk-runtime && tsx --test scripts/sdk-release-catalog.test.ts",
    "verify:sdk-artifact": "node scripts/verify-sdk-artifact.mjs",
    "verify:public-sdk-releases": "node --test scripts/verify-public-sdk-releases.test.mjs && node scripts/verify-public-sdk-releases.mjs",
    "sdk:pack": "pnpm run check:sdk-runtime && node scripts/package-sdk.mjs",
    "check:sdk-runtime": "tsx --experimental-test-module-mocks --test scripts/sdk-request-budget.test.ts scripts/sdk-backward-compatibility.test.ts"
  },
  "dependencies": {
    "@allauth/stripe-client": "npm:stripe@23.1.0",
    "@base-ui/react": "1.8.0",
    "@better-auth-ui/core": "1.7.27",
    "@better-auth-ui/react": "1.7.27",
    "@better-auth/agent-auth": "0.6.2",
