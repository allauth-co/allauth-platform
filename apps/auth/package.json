    "better-auth": "link:../../packages/better-auth",
    "bowser": "2.14.1",
    "canvas-confetti": "^1.9.4",
    "chargebee": "3.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "date-fns": "^4.1.0",
    "dub": "0.73.5",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.3",
    "geist": "^1.7.0",
