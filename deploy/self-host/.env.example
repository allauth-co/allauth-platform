# Copy to repository-root .env.self-host. Never commit real secrets.
# Use a domain you control; production authentication requires HTTPS.
ALLAUTH_DOMAIN=auth.example.com
POSTGRES_PASSWORD=replace-with-random-url-safe-hex
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
SCIM_CREDENTIAL_HASH_SECRET=replace-with-a-different-random-secret
ALLAUTH_DEPLOYMENT_MODE=self-hosted
AUTH_APP_NAME=My authentication service
RP_NAME=My authentication service
EMAIL_FROM=security@example.com
EMAIL_FROM_NAME=My application

# Optional platform email transport. Email links, verification and invitations
# require a working provider, but initial administrator creation does not.
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Optional OAuth providers. Register callbacks on your own auth domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
